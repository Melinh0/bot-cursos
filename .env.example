# DataScienceAcademy Bot Configuration
# Copy this file to .env and fill in your values

# Authentication
DSA_EMAIL=your_email@example.com
DSA_PASSWORD=your_password

# LLM Configuration (OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Ollama API Keys (rotating fallback)
OLLAMA_API_KEYS=key1,key2,key3

# Browser Configuration
HEADLESS=false
BROWSER_TIMEOUT=30
IMPLICIT_WAIT=10

# Course Configuration
TARGET_COURSE_URL=https://www.datascienceacademy.com.br/path-player?courseid=fundamentos-de-linguagem-python-para-analise-de-dados-e-data-science&unit=63aa11114343420e8702d3c7Unit
AUTO_DISCOVER_COURSES=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=5