# DataScienceAcademy Bot Configuration
# Copy this file to .env and fill in your values

# Authentication
DSA_EMAIL=your_email@example.com
DSA_PASSWORD=your_password

# LLM Configuration (OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Ollama API Keys (rotating fallback)
OLLAMA_API_KEYS=key1,key2,key3

# Browser Configuration
HEADLESS=false
BROWSER_TIMEOUT=30
IMPLICIT_WAIT=0
BROWSER_HALF_SCREEN=true

# Humanize / watchdog
HUMANIZE_DELAY_MIN=0.4
HUMANIZE_DELAY_MAX=1.2
UNIT_TIMEOUT_SECONDS=180
UNIT_MIN_DWELL_SECONDS=15
UNIT_ACTIVITY_FLUSH_SECONDS=10
MAX_STUCK_ATTEMPTS=3
SMOKE_MODE=false

# Course Configuration
AUTO_DISCOVER_COURSES=true
MAX_RUN_ATTEMPTS=3
MAX_UNITS_PER_RUN=0
MAX_RECOVERY_ROUNDS=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=5